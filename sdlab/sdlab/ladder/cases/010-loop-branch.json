{
  "title": "A loop with a branch",
  "level": 7,
  "tags": ["loop", "link", "move", "branch"],
  "tests": "a link loop with a move leaving it to a third stock: the loop's stock splits its drain between the branch and outside",
  "model": {
    "seed": 10,
    "stocks": [
      {"id": "A", "initial": 0},
      {"id": "B", "initial": 0},
      {"id": "C", "initial": 0}
    ],
    "flows": [
      {"id": "in", "from": null, "to": "A", "rate": {"form": "constant", "value": 10}},
      {"id": "ab", "from": "A", "to": "B", "rate": {"form": "proportional", "stock": "A", "k": 0.5}},
      {"id": "b_out", "from": "B", "to": null, "rate": {"form": "proportional", "stock": "B", "k": 0.2}},
      {"id": "births", "from": null, "to": "A", "rate": {"form": "proportional", "stock": "B", "k": 0.05}},
      {"id": "bc", "from": "B", "to": "C", "rate": {"form": "proportional", "stock": "B", "k": 0.1}},
      {"id": "c_out", "from": "C", "to": null, "rate": {"form": "proportional", "stock": "C", "k": 0.1}}
    ]
  }
}
