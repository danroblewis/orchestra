{
  "title": "One stock splitting in two",
  "level": 11,
  "tags": ["split", "move"],
  "tests": "one stock drains into two measured stocks at different rates",
  "model": {
    "seed": 14,
    "stocks": [
      {"id": "A", "initial": 0},
      {"id": "B", "initial": 0},
      {"id": "C", "initial": 0}
    ],
    "flows": [
      {"id": "in", "from": null, "to": "A", "rate": {"form": "constant", "value": 20}},
      {"id": "ab", "from": "A", "to": "B", "rate": {"form": "proportional", "stock": "A", "k": 0.2}},
      {"id": "ac", "from": "A", "to": "C", "rate": {"form": "proportional", "stock": "A", "k": 0.1}},
      {"id": "b_out", "from": "B", "to": null, "rate": {"form": "proportional", "stock": "B", "k": 0.1}},
      {"id": "c_out", "from": "C", "to": null, "rate": {"form": "proportional", "stock": "C", "k": 0.05}}
    ]
  }
}
