{
  "title": "A co-flow",
  "level": 12,
  "tags": ["coflow"],
  "tests": "a move that uses up a third stock as it goes (0.5 of R per unit moved) is recovered as a co-flow",
  "model": {
    "seed": 16,
    "stocks": [
      {"id": "A", "initial": 0},
      {"id": "B", "initial": 0},
      {"id": "R", "initial": 60}
    ],
    "flows": [
      {"id": "in", "from": null, "to": "A", "rate": {"form": "constant", "value": 10}},
      {"id": "ab", "from": "A", "to": "B", "rate": {"form": "proportional", "stock": "A", "k": 0.3}, "uses": [{"stock": "R", "per": 0.5}]},
      {"id": "b_out", "from": "B", "to": null, "rate": {"form": "proportional", "stock": "B", "k": 0.2}},
      {"id": "r_in", "from": null, "to": "R", "rate": {"form": "constant", "value": 8}},
      {"id": "r_out", "from": "R", "to": null, "rate": {"form": "proportional", "stock": "R", "k": 0.05}}
    ]
  }
}
