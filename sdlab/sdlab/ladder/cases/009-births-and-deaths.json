{
  "title": "Births and deaths",
  "level": 6,
  "tags": ["loop", "self-link", "aliasing"],
  "tests": "births and deaths in proportion to the same stock: only their difference is identifiable, so the best answer is an equivalent net flow",
  "model": {
    "seed": 9,
    "stocks": [
      {"id": "P", "initial": 100}
    ],
    "flows": [
      {"id": "immigration", "from": null, "to": "P", "rate": {"form": "constant", "value": 10}},
      {"id": "births", "from": null, "to": "P", "rate": {"form": "proportional", "stock": "P", "k": 0.03}},
      {"id": "deaths", "from": "P", "to": null, "rate": {"form": "proportional", "stock": "P", "k": 0.05}}
    ]
  }
}
