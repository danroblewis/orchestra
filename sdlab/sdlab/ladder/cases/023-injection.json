{
  "title": "Announced injections",
  "level": 12,
  "tags": ["injection", "announced"],
  "tests": "announced injections (400 added to A now and then) are taken as given, and the chain's rates are recovered",
  "model": {
    "seed": 23,
    "stocks": [
      {"id": "A", "initial": 0},
      {"id": "B", "initial": 0}
    ],
    "flows": [
      {"id": "in", "from": null, "to": "A", "rate": {"form": "constant", "value": 10}},
      {"id": "ab", "from": "A", "to": "B", "rate": {"form": "proportional", "stock": "A", "k": 0.5}},
      {"id": "b_out", "from": "B", "to": null, "rate": {"form": "proportional", "stock": "B", "k": 0.2}}
    ],
    "injections": [{"t": 50, "stock": "A", "amount": 400}, {"t": 150, "stock": "A", "amount": 400}, {"t": 250, "stock": "A", "amount": 400}, {"t": 650, "stock": "A", "amount": 400}, {"t": 1050, "stock": "A", "amount": 400}, {"t": 1450, "stock": "A", "amount": 400}, {"t": 1850, "stock": "A", "amount": 400}]
  }
}
