{
  "title": "Chain of three",
  "level": 3,
  "tags": ["chain", "move"],
  "tests": "two moves in a row are recovered, each at its own rate",
  "model": {
    "seed": 4,
    "stocks": [
      {"id": "A", "initial": 0},
      {"id": "B", "initial": 0},
      {"id": "C", "initial": 0}
    ],
    "flows": [
      {"id": "in", "from": null, "to": "A", "rate": {"form": "constant", "value": 20}},
      {"id": "ab", "from": "A", "to": "B", "rate": {"form": "proportional", "stock": "A", "k": 0.5}},
      {"id": "bc", "from": "B", "to": "C", "rate": {"form": "proportional", "stock": "B", "k": 0.25}},
      {"id": "c_out", "from": "C", "to": null, "rate": {"form": "proportional", "stock": "C", "k": 0.1}}
    ]
  }
}
