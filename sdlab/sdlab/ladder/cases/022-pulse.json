{
  "title": "A pulse input",
  "level": 12,
  "tags": ["inflow-change", "pulse", "unannounced"],
  "tests": "a one-step burst of 300 into a chain every 100 steps (unannounced) does not distort the chain's rates",
  "model": {
    "seed": 22,
    "stocks": [
      {"id": "A", "initial": 0},
      {"id": "B", "initial": 0}
    ],
    "flows": [
      {"id": "in", "from": null, "to": "A", "rate": {"form": "constant", "value": 10}},
      {"id": "ab", "from": "A", "to": "B", "rate": {"form": "proportional", "stock": "A", "k": 0.5}},
      {"id": "b_out", "from": "B", "to": null, "rate": {"form": "proportional", "stock": "B", "k": 0.2}}
    ],
    "schedule": {"every": 100, "changes": [{"t": 50, "label": "burst", "set": {"in": {"form": "constant", "value": 300}}}, {"t": 51, "label": "calm", "set": {"in": {"form": "constant", "value": 10}}}]}
  }
}
