{
  "title": "Chain of two",
  "level": 2,
  "tags": ["chain", "move"],
  "tests": "a proportional move between two measured stocks, with the chain's inflow and exit, is recovered",
  "model": {
    "seed": 3,
    "stocks": [
      {"id": "A", "initial": 0},
      {"id": "B", "initial": 0}
    ],
    "flows": [
      {"id": "in", "from": null, "to": "A", "rate": {"form": "constant", "value": 20}},
      {"id": "ab", "from": "A", "to": "B", "rate": {"form": "proportional", "stock": "A", "k": 0.5}},
      {"id": "b_out", "from": "B", "to": null, "rate": {"form": "proportional", "stock": "B", "k": 0.2}}
    ]
  }
}
