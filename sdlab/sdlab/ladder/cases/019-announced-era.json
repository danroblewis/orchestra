{
  "title": "An announced era",
  "level": 12,
  "tags": ["eras", "announced"],
  "tests": "a move's rate that changes at announced eras (0.5 in one, 0.25 in the other) is recovered per era",
  "model": {
    "seed": 19,
    "stocks": [
      {"id": "A", "initial": 0},
      {"id": "B", "initial": 0}
    ],
    "flows": [
      {"id": "in", "from": null, "to": "A", "rate": {"form": "constant", "value": 20}},
      {"id": "ab", "from": "A", "to": "B", "rate": {"form": "proportional", "stock": "A", "k": 0.5}},
      {"id": "b_out", "from": "B", "to": null, "rate": {"form": "proportional", "stock": "B", "k": 0.2}}
    ],
    "schedule": {"every": 200, "changes": [{"t": 1, "label": "fast", "set": {"ab": {"form": "proportional", "stock": "A", "k": 0.5}}, "announce": true}, {"t": 101, "label": "slow", "set": {"ab": {"form": "proportional", "stock": "A", "k": 0.25}}, "announce": true}]}
  }
}
