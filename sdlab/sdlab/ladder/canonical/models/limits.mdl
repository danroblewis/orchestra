{UTF-8}
Population= INTEG (
	Births-Deaths,
		50)
	~	Animals
	~	The limits-to-growth archetype (Meadows et al. 1972; Senge 1990): growth feeds on a renewable resource that it erodes; written for SD Lab.
	|
Resource= INTEG (
	Regeneration-Consumption,
		1000)
	~	Units
	~	
	|
Births=
	Birth Rate*Population*Resource Adequacy(Resource)
	~	Animals/Year
	~	Births fall as the resource runs short.
	|
Deaths=
	Population/Lifetime
	~	Animals/Year
	~	
	|
Regeneration=
	Regeneration Rate*Resource*(1-Resource/Resource Capacity)
	~	Units/Year
	~	Logistic regrowth.
	|
Consumption=
	Consumption per Animal*Population*Resource/Resource Capacity
	~	Units/Year
	~	Grazing slows as the resource thins.
	|
Resource Adequacy(
	[(0,0)-(1000,1.5)],(0,0),(250,0.4),(500,0.8),(750,1),(1000,1.1))
	~	Dmnl
	~	By resource (Units).
	|
Birth Rate=
	0.12
	~	1/Year
	~	
	|
Lifetime=
	12
	~	Year
	~	
	|
Regeneration Rate=
	0.3
	~	1/Year
	~	
	|
Resource Capacity=
	1000
	~	Units
	~	
	|
Consumption per Animal=
	0.4
	~	Units/Animal/Year
	~	
	|
********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|
FINAL TIME  = 200
	~	Year
	~		|
INITIAL TIME  = 0
	~	Year
	~		|
SAVEPER  = 
        TIME STEP
	~	Year
	~		|
TIME STEP  = 1
	~	Year
	~		|
