{
 "id": "sd-print-shop-truth",
 "name": "SD: A print shop's paper and toner: the truth",
 "description": "Tests co-flows that share and combine: mono and colour printing both use paper and toner (two flows using the same stock), and each page printed uses both (one flow using two stocks). Colour pages take ten times the toner of mono ones, so a rush of colour work empties the toner and slows both printers; a late paper delivery stops them both. Paper and toner are restocked toward targets.",
 "time_unit": "hour",
 "seed": 20261018,
 "steps": 1000,
 "long_steps": 10000,
 "noise": {
  "counts": true
 },
 "stocks": [
  {"id": "mono_queue", "name": "Mono pages queued", "unit": "pages", "initial": 400, "x": 80, "y": 120},
  {"id": "colour_queue", "name": "Colour pages queued", "unit": "pages", "initial": 100, "x": 80, "y": 300},
  {"id": "done", "name": "Printed, awaiting collection", "unit": "pages", "initial": 1200, "x": 560, "y": 200},
  {"id": "paper", "name": "Paper on hand", "unit": "sheets", "initial": 2500, "x": 320, "y": 40},
  {"id": "toner", "name": "Toner on hand", "unit": "g", "initial": 240, "x": 320, "y": 380}
 ],
 "flows": [
  {"id": "mono_jobs", "name": "Mono pages sent", "from": null, "to": "mono_queue",
   "rate": {"form": "constant", "value": 200}, "machine": "environment"},
  {"id": "colour_jobs", "name": "Colour pages sent", "from": null, "to": "colour_queue",
   "rate": {"form": "constant", "value": 40}, "machine": "environment"},
  {"id": "print_mono", "name": "Mono printing", "from": "mono_queue", "to": "done",
   "rate": {"form": "proportional", "stock": "mono_queue", "k": 0.5},
   "uses": [{"stock": "paper", "per": 1}, {"stock": "toner", "per": 0.04}], "machine": "environment"},
  {"id": "print_colour", "name": "Colour printing", "from": "colour_queue", "to": "done",
   "rate": {"form": "proportional", "stock": "colour_queue", "k": 0.4},
   "uses": [{"stock": "paper", "per": 1}, {"stock": "toner", "per": 0.4}], "machine": "environment"},
  {"id": "collect", "name": "Collected", "from": "done", "to": null,
   "rate": {"form": "proportional", "stock": "done", "k": 0.2}, "machine": "environment"},
  {"id": "paper_restock", "name": "Paper delivered", "from": null, "to": "paper",
   "rate": {"form": "gap", "stock": "paper", "goal": 3000, "time": 5}, "machine": "environment"},
  {"id": "toner_restock", "name": "Toner delivered", "from": null, "to": "toner",
   "rate": {"form": "gap", "stock": "toner", "goal": 600, "time": 15}, "machine": "environment"}
 ],
 "machines": [],
 "schedule": {
  "every": 200,
  "changes": [
   {"t": 1, "label": "Normal work (200 mono and 40 colour pages an hour), deliveries on time",
    "set": {"mono_jobs": {"form": "constant", "value": 200}, "colour_jobs": {"form": "constant", "value": 40},
            "paper_restock": {"form": "gap", "stock": "paper", "goal": 3000, "time": 5},
            "toner_restock": {"form": "gap", "stock": "toner", "goal": 600, "time": 15}}},
   {"t": 41, "label": "Colour rush (110 colour pages an hour)", "set": {"colour_jobs": {"form": "constant", "value": 110}}},
   {"t": 81, "label": "Colour back to normal", "set": {"colour_jobs": {"form": "constant", "value": 40}}},
   {"t": 101, "label": "Paper supplier late (six times slower)", "set": {"paper_restock": {"form": "gap", "stock": "paper", "goal": 3000, "time": 30}}},
   {"t": 141, "label": "Paper supplier back on time", "set": {"paper_restock": {"form": "gap", "stock": "paper", "goal": 3000, "time": 5}}},
   {"t": 161, "label": "Busy mono (300 pages an hour)", "set": {"mono_jobs": {"form": "constant", "value": 300}}}
  ]
 }
}
