{
 "id": "sd-k8s-small",
 "name": "SD: Kubernetes, 5 services",
 "description": "5 services on Kubernetes serving HTTP requests behind an edge load balancer, measured every minute for 7 days (Monday to Sunday): requests in flight, CPU used, memory working set per pod, desired and ready replicas and OOM restarts for every service; nodes and CPU and memory requested per node pool. The main input is the traffic at the edge (a measured input: a daily cycle peaking around midday with weekend dips and a Friday-evening spike). Inside, each service has a load-balancer queue, retries, an HPA scaling on CPU (fast up, slow down), pods pending, starting, ready and terminating, CPU throttling at the limit, memory growing with load (and leaking in some), and OOM kills; the cluster autoscaler adds nodes for pending pods and removes underused ones. Events: a rolling update of catalog-api, catalog (announced); a node failure in pool general (an announced injection). 34 measured stocks, 40 hidden, 168 flows. The ground truth is in sd-k8s-small/truth.model.json, built from the service catalogue sdlab/examples/k8s/small.yaml; docs/research/k8s-model.md maps each stock to its Prometheus metric.",
 "time_unit": "minute",
 "horizon": 240,
 "dt": 1,
 "stocks": [
  {
   "id": "ingress",
   "name": "Edge load balancer: requests this minute",
   "unit": "requests",
   "initial": 8021,
   "x": 80,
   "y": 60,
   "query": "sum(increase(nginx_ingress_controller_requests[1m]))"
  },
  {
   "id": "web_frontend_inflight",
   "name": "web-frontend: requests in flight",
   "unit": "requests",
   "initial": 8021,
   "x": 270,
   "y": 280,
   "query": "sum(increase(http_server_requests_total{service=\"web-frontend\"}[1m]))"
  },
  {
   "id": "web_frontend_cpu",
   "name": "web-frontend: CPU used",
   "unit": "millicores",
   "initial": 1149,
   "x": 650,
   "y": 280,
   "query": "1000 * sum(rate(container_cpu_usage_seconds_total{container=\"web-frontend\"}[2m]))"
  },
  {
   "id": "web_frontend_mem",
   "name": "web-frontend: memory working set per pod",
   "unit": "MiB",
   "initial": 273,
   "x": 1220,
   "y": 280,
   "query": "avg(container_memory_working_set_bytes{container=\"web-frontend\"}) / 2^20"
  },
  {
   "id": "web_frontend_desired",
   "name": "web-frontend: desired replicas (HPA)",
   "unit": "pods",
   "initial": 8,
   "x": 1600,
   "y": 280,
   "query": "kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"web-frontend\"}"
  },
  {
   "id": "web_frontend_ready",
   "name": "web-frontend: ready replicas",
   "unit": "pods",
   "initial": 8,
   "x": 2170,
   "y": 280,
   "query": "kube_deployment_status_replicas_ready{deployment=\"web-frontend\"}"
  },
  {
   "id": "web_frontend_oom",
   "name": "web-frontend: pods restarting after an OOM kill",
   "unit": "pods",
   "initial": 0,
   "x": 2550,
   "y": 280,
   "query": "sum(increase(kube_pod_container_status_restarts_total{container=\"web-frontend\"}[1m]) and on(pod) kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"})"
  },
