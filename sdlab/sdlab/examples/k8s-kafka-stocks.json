{
 "id": "k8s-kafka-stocks",
 "name": "Kafka lag, stocks only (Prometheus)",
 "description": "Only the lag of every consumer group, read from Prometheus, with no flows at all. Import history, then Discover flows with nothing selected: it guesses the flows from the lag alone. A lag level only shows produced minus consumed, so where a topic is steady nothing can be seen; where the lag moves, discovery proposes one net flow in or out.",
 "time_unit": "5-minute step",
 "step_seconds": 300,
 "horizon": 288,
 "dt": 0.25,
